full_domain_soundness_lemma: LEMMA
    FORALL(x,xo,yo:real):
    LET
        g = LAMBDA(x:real): COND (x < 1.0) AND
     (x >= 0) -> 182.0*x, (x >= 1.0) AND
     (x < 2.0) -> 182.000000000000, (x >= 2.0) AND
     (x < 3.0) -> 426.2 - 122.1*x, (x >= 3.0) AND
     (x < 7.0) -> 59.9000000000000, (x >= 7.0) AND
     (x < 8.0) -> 35.6*x - 189.3, (x >= 8.0) AND
     (x < 9.0) -> 1551.5 - 182.0*x, (x >= 9.0) AND
     (x < 10.0) -> 146.4*x - 1404.1, (x >= 10.0) AND
     (x < 11.0) -> 59.9000000000000, (x >= 11.0) AND
     (x < 12.0) -> 718.8 - 59.9*x, ELSE -> 0 ENDCOND
    IN
    (((-x + xo + 1 >= 0) AND
     (-x + xo - 1 <= 0) AND
     (yo - g(x) + 1 >= 0) AND
     (yo - g(x) - 1 <= 0)) AND
    xo + 1 >= x AND xo + -1 <= x)
    IMPLIES
    ((yo - f0(g)(xo - 1) - 1 >= 0) AND
     (yo - f0(g)(xo + 1) + 1 <= 0)) OR
    ((yo - f0(g)(xo - 1) + 1 >= 0) AND
     (yo - f0(g)(xo + 1) - 1 <= 0)) OR
    ((yo - f0(g)(xo + 1) - 1 >= 0) AND
     (yo - f0(g)(xo - 1) + 1 <= 0)) OR
    ((yo - f0(g)(xo + 1) + 1 >= 0) AND
     (yo - f0(g)(xo - 1) - 1 <= 0)) OR
((yo - f1(g)(xo - 1) - 1 >= 0) AND
     (yo - f1(g)(xo + 1) + 1 <= 0)) OR
    ((yo - f1(g)(xo - 1) + 1 >= 0) AND
     (yo - f1(g)(xo + 1) - 1 <= 0)) OR
    ((yo - f1(g)(xo + 1) - 1 >= 0) AND
     (yo - f1(g)(xo - 1) + 1 <= 0)) OR
    ((yo - f1(g)(xo + 1) + 1 >= 0) AND
     (yo - f1(g)(xo - 1) - 1 <= 0)) OR
((yo - f2(g)(xo - 1) - 1 >= 0) AND
     (yo - f2(g)(xo + 1) + 1 <= 0)) OR
    ((yo - f2(g)(xo - 1) + 1 >= 0) AND
     (yo - f2(g)(xo + 1) - 1 <= 0)) OR
    ((yo - f2(g)(xo + 1) - 1 >= 0) AND
     (yo - f2(g)(xo - 1) + 1 <= 0)) OR
    ((yo - f2(g)(xo + 1) + 1 >= 0) AND
     (yo - f2(g)(xo - 1) - 1 <= 0)) OR
((yo - f3(g)(xo - 1) - 1 >= 0) AND
     (yo - f3(g)(xo + 1) + 1 <= 0)) OR
    ((yo - f3(g)(xo - 1) + 1 >= 0) AND
     (yo - f3(g)(xo + 1) - 1 <= 0)) OR
    ((yo - f3(g)(xo + 1) - 1 >= 0) AND
     (yo - f3(g)(xo - 1) + 1 <= 0)) OR
    ((yo - f3(g)(xo + 1) + 1 >= 0) AND
     (yo - f3(g)(xo - 1) - 1 <= 0)) OR
((yo - f4(g)(xo - 1) - 1 >= 0) AND
     (yo - f4(g)(xo + 1) + 1 <= 0)) OR
    ((yo - f4(g)(xo - 1) + 1 >= 0) AND
     (yo - f4(g)(xo + 1) - 1 <= 0)) OR
    ((yo - f4(g)(xo + 1) - 1 >= 0) AND
     (yo - f4(g)(xo - 1) + 1 <= 0)) OR
    ((yo - f4(g)(xo + 1) + 1 >= 0) AND
     (yo - f4(g)(xo - 1) - 1 <= 0)) OR
((yo - f5(g)(xo - 1) - 1 >= 0) AND
     (yo - f5(g)(xo + 1) + 1 <= 0)) OR
    ((yo - f5(g)(xo - 1) + 1 >= 0) AND
     (yo - f5(g)(xo + 1) - 1 <= 0)) OR
    ((yo - f5(g)(xo + 1) - 1 >= 0) AND
     (yo - f5(g)(xo - 1) + 1 <= 0)) OR
    ((yo - f5(g)(xo + 1) + 1 >= 0) AND
     (yo - f5(g)(xo - 1) - 1 <= 0)) OR
((yo - f6(g)(xo - 1) - 1 >= 0) AND
     (yo - f6(g)(xo + 1) + 1 <= 0)) OR
    ((yo - f6(g)(xo - 1) + 1 >= 0) AND
     (yo - f6(g)(xo + 1) - 1 <= 0)) OR
    ((yo - f6(g)(xo + 1) - 1 >= 0) AND
     (yo - f6(g)(xo - 1) + 1 <= 0)) OR
    ((yo - f6(g)(xo + 1) + 1 >= 0) AND
     (yo - f6(g)(xo - 1) - 1 <= 0)) OR
((yo - f7(g)(xo - 1) - 1 >= 0) AND
     (yo - f7(g)(xo + 1) + 1 <= 0)) OR
    ((yo - f7(g)(xo - 1) + 1 >= 0) AND
