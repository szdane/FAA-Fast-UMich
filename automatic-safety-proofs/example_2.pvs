     (yo - f(xo - 1) - 1 <= 0))OR
    (((xo - 11 >= 0) AND
     (xo - 13 <= 0) AND
     (yo - f(12) + 1 >= 0) AND
     (yo - f(12) - 1 <= 0)) OR
    ((xo - 10 >= 0) AND
     (xo - 12 <= 0) AND
     (yo - f(11) + 1 >= 0) AND
     (yo - f(11) - 1 <= 0)))

