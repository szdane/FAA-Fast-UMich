%|-         (THEN (EXPAND "ci") (ASSERT)) (THEN (EXPAND "ci") (ASSERT)))))
%|-      (THEN (ASSERT)
%|-       (SPREAD (CASE "xo - 1 >= 12 AND xo + 1 > 13")
%|-        ((THEN (FLATTEN) (LEMMA "mvt_gen_le_ci")
