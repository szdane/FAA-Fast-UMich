le_ci_case_9: LEMMA
    FORALL(xo,yo:real, g:[real -> real]):
        LET f = LAMBDA(x:real):
        COND
            x < 12 -> g(12),
            x >= 12 AND x <= 13 -> g(x),
            ELSE -> g(13)
        ENDCOND
    IN 
    derivable?[(ci(12, 13))](f) AND (FORALL(x:(ci(12, 13))): deriv[(ci(12, 13))](f)(x) <= 0) AND
    (EXISTS (x : real) :
    ((-x + xo + 1 >= 0) AND
     (-x + xo - 1 <= 0) AND
     (yo - f(x) + 1 >= 0) AND
     (yo - f(x) - 1 <= 0)) AND
    x >= 12 AND x <= 13 AND
    xo + 1 >= x AND xo + -1 <= x)
    IMPLIES
    ((yo - f(xo - 1) - 1 >= 0) AND
     (yo - f(xo + 1) + 1 <= 0)) OR
    ((yo - f(xo - 1) + 1 >= 0) AND
     (yo - f(xo + 1) - 1 <= 0)) OR
    ((yo - f(xo + 1) - 1 >= 0) AND
     (yo - f(xo - 1) + 1 <= 0)) OR
    ((yo - f(xo + 1) + 1 >= 0) AND
     (yo - f(xo - 1) - 1 <= 0))OR
    (((xo - 12 >= 0) AND
     (xo - 14 <= 0) AND
     (yo - f(13) + 1 >= 0) AND
     (yo - f(13) - 1 <= 0)) OR
    ((xo - 11 >= 0) AND
     (xo - 13 <= 0) AND
     (yo - f(12) + 1 >= 0) AND
     (yo - f(12) - 1 <= 0)))

%|- le_ci_case_9 : PROOF
%|- (THEN (SKEEP*) (SKOLETIN*) (FLATTEN) (SKEEP)
