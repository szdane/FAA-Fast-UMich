# Airport coordinates and names
airport_coordinates = {
    "KFNT": (42.9654, -83.7436),  # Flint, MI
    "KDTW": (42.2125, -83.3534),  # Detroit, MI
    "KTOL": (41.5868, -83.8078),  # Toledo, OH
    "KCLE": (41.4118, -81.8498),  # Cleveland, OH
    "KPIT": (40.4915, -80.2329),  # Pittsburgh, PA
    "KBUF": (42.9405, -78.7322),  # Buffalo, NY
    "KROC": (43.1189, -77.6724),  # Rochester, NY
    "KCMH": (39.9612, -82.9988)  # Columbus, OH
}

# Define the projection and create a figure
proj = ccrs.LambertConformal()
fig = plt.figure(figsize=(15, 10))
ax = fig.add_subplot(1, 1, 1, projection=proj)

# Set the extent to only show the region of interest
ax.set_extent([-85, -75, 38, 45], ccrs.Geodetic())

# Add state boundaries
ax.add_feature(cfeature.NaturalEarthFeature(
    category='cultural',
    name='admin_1_states_provinces_lines',
    scale='50m',
    facecolor='none'), edgecolor='black')

# Add country boundaries and coastlines
ax.add_feature(cfeature.BORDERS)
ax.add_feature(cfeature.COASTLINE)
ax.add_feature(cfeature.LAND.with_scale('50m'), color='lightyellow')

# Plot ARTCC boundaries
for i, coords in enumerate(regions_coordinates):
    polygon = ShapelyPolygon(coords)
    x, y = polygon.exterior.xy
    ax.plot(x, y, transform=ccrs.Geodetic(), color='red', linewidth=2)
    centroid = polygon.centroid
    ax.text(centroid.x, centroid.y, f'Region {i+1}', fontsize=15, ha='center', va='center', color='red', transform=ccrs.Geodetic())

# Plot airports
for code, (lat, lon) in airport_coordinates.items():
    ax.plot(lon, lat, marker='o', color='blue', markersize=5, transform=ccrs.Geodetic())
    ax.text(lon, lat, code, fontsize=10, ha='right', va='bottom', color='blue', transform=ccrs.Geodetic())

# Save the plot as sector.png
plt.savefig('output/sector.png')

plt.show()
